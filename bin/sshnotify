#!/bin/bash
host="${1:?Usage: sshnotify <host>}"
tunnel_port=19222

# Split "$TITLE|$MSG|$NONFOCUS" from the tunnel into three args for notify.
# (MSG may contain '|'; TITLE is before the first, NONFOCUS is after the last.)

if command -v socat &>/dev/null; then
    socat TCP-LISTEN:${tunnel_port},bind=127.0.0.1,reuseaddr,fork \
        SYSTEM:'read -r line; _t="${line%%|*}"; _r="${line#*|}"; notify \"$_t\" \"${_r%|*}\" \"${_r##*|}\"' &
    listener_pid=$!
else
    while true; do
        line=$(nc -l -p ${tunnel_port} -q 1 2>/dev/null) || break
        [[ -z "$line" ]] && continue
        _r="${line#*|}"
        notify "${line%%|*}" "${_r%|*}" "${_r##*|}"
    done &
    listener_pid=$!
fi

trap 'kill "$listener_pid" 2>/dev/null; wait "$listener_pid" 2>/dev/null' EXIT

SSH_CLIENT_NOTIFY=${tunnel_port} ssh \
    -o SendEnv=SSH_CLIENT_NOTIFY \
    -R ${tunnel_port}:localhost:${tunnel_port} \
    "$@"

exit $?
