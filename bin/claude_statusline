#!/bin/sh
# Claude Code status line: reads JSON from stdin, outputs formatted status.
d=$(cat)
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
dir=$(printf '%s' "$d" | jq -r --arg h "$HOME/" '.cwd | ltrimstr($h)')
model=$(printf '%s' "$d" | jq -r '.model.display_name')
ctx=$(printf '%s' "$d" | jq -r '.context_window.used_percentage // 0')
if [ -n "$branch" ]; then
    printf '%s %s [%s, %s%% context]' "$dir" "$branch" "$model" "$ctx"
else
    printf '%s [%s, %s%% context]' "$dir" "$model" "$ctx"
fi
