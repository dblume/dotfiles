Host *
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_rsa
Host github.com
  # optional directory-based overrides in ~/.gitconfig
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
Host dlma.com
  # User 
  # Must `eval "$(ssh-agent -s)"` and add key at client
  ForwardAgent yes
